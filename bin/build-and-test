#!/bin/bash
set -euo pipefail

echo "🔧 Building framework dependencies..."

# The local maplibre-gl-native-distribution package has no binary until this
# runs, so the package graph won't resolve without it.
./bin/build-maplibre-native

# Build the ferrostar iOS framework from its directory
pushd DevDependencies/ferrostar/common
./build-ios.sh
popd

pushd DevDependencies/headway
./bin/build-ios.sh
popd

echo "✅ Finished building framework dependencies!"

# Now run the tests
echo ""
./bin/test
