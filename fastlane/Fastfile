default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
XCODEPROJ = File.join(ROOT, "maps.earth.xcodeproj")

platform :ios do
  private_lane :bump_build do
    increment_build_number(
      xcodeproj: "maps.earth.xcodeproj"
    )
    version = get_version_number(xcodeproj: "maps.earth.xcodeproj", target: "maps.earth")
    build   = get_build_number(xcodeproj: "maps.earth.xcodeproj")
    git_commit(
      path: "maps.earth.xcodeproj/project.pbxproj",
      message: "Bump build to v#{version} (#{build})"
    )
  end

  private_lane :bump_version do
    version = get_version_number(xcodeproj: "maps.earth.xcodeproj", target: "maps.earth")
    major, minor = version.split(".")
    set_marketing_version(version: "#{major}.#{minor.to_i + 1}")
    increment_build_number(
      build_number: 0,
      xcodeproj: "maps.earth.xcodeproj"
    )
    version = get_version_number(xcodeproj: "maps.earth.xcodeproj", target: "maps.earth")
    build   = get_build_number(xcodeproj: "maps.earth.xcodeproj")
    git_commit(
      path: "maps.earth.xcodeproj/project.pbxproj",
      message: "Bump version to v#{version} (#{build})"
    )
  end

  desc "Compile for the simulator, a faster check than a full archive"
  lane :build do
    sh(File.join(ROOT, "bin/build"))
  end

  desc "Archive the app, without touching versions or git"
  lane :archive do
    sh(File.join(ROOT, "bin/check-frameworks"))
    build_app(
      project: "maps.earth.xcodeproj",
      scheme: "maps.earth",
      configuration: "Release",
      output_directory: "build",
      output_name: "maps.earth.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "automatic"
      }
    )
  end

  desc "Bump build (or minor version with bump_version:true), archive, and tag an alpha"
  lane :cut_alpha do |options|
    sh(File.join(ROOT, "bin/build-frameworks"), "--optimized")
    options[:bump_version] ? bump_version : bump_build
    archive
    tag_alpha
  end

  desc "Tag current version as alpha (e.g. v1.14.alpha2)"
  lane :tag_alpha do
    version = get_version_number(xcodeproj: "maps.earth.xcodeproj", target: "maps.earth")
    build   = get_build_number(xcodeproj: "maps.earth.xcodeproj")
    add_git_tag(tag: "v#{version}.alpha#{build}")
  end

  desc "Tag current version as beta (e.g. v1.14.beta2)"
  lane :tag_beta do
    version = get_version_number(xcodeproj: "maps.earth.xcodeproj", target: "maps.earth")
    build   = get_build_number(xcodeproj: "maps.earth.xcodeproj")
    add_git_tag(tag: "v#{version}.beta#{build}")
  end

  desc "Upload most recent build to App Store Connect"
  lane :upload do
    upload_to_app_store(
      ipa: "build/maps.earth.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  # agvtool can't manage the marketing version of a GENERATE_INFOPLIST_FILE
  # project, so write MARKETING_VERSION into the build settings directly.
  private_lane :set_marketing_version do |options|
    version = options[:version]
    project = Xcodeproj::Project.open(XCODEPROJ)
    target = project.targets.find { |t| t.name == "maps.earth" }
    target.build_configurations.each do |config|
      config.build_settings["MARKETING_VERSION"] = version
    end
    project.save
    UI.success("Set MARKETING_VERSION to #{version}")
  end
end
